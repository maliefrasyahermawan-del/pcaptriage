<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>PCAPTriage Report</title>
<style>
  :root {
    --bg:#0f1419; --fg:#e6e6e6; --muted:#7a8595; --card:#1b222c;
    --crit:#ff3b3b; --high:#ff8c1a; --med:#ffd23b; --low:#3bb4ff; --info:#7a8595;
    --accent:#00d4aa;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--fg);
       font-family:-apple-system,Segoe UI,Roboto,sans-serif;font-size:14px}
  header{padding:20px 28px;border-bottom:1px solid #2a3340;background:#141a23}
  header h1{margin:0 0 4px;font-size:22px;color:var(--accent)}
  header .sub{color:var(--muted);font-size:12px}
  .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
         gap:14px;padding:20px 28px}
  .card{background:var(--card);padding:14px 16px;border-radius:8px;
        border-left:4px solid var(--accent)}
  .card h3{margin:0;font-size:11px;text-transform:uppercase;color:var(--muted);
           letter-spacing:1px}
  .card .v{font-size:22px;font-weight:600;margin-top:4px}
  .card.crit{border-color:var(--crit)} .card.high{border-color:var(--high)}
  .card.med{border-color:var(--med)} .card.low{border-color:var(--low)}
  .card.info{border-color:var(--info)}
  .toolbar{display:flex;gap:10px;padding:0 28px 14px;flex-wrap:wrap}
  .toolbar input,.toolbar select{
    background:var(--card);color:var(--fg);border:1px solid #2a3340;
    padding:8px 10px;border-radius:6px;font-size:13px}
  .toolbar input{flex:1;min-width:220px}
  table{width:calc(100% - 56px);margin:0 28px 28px;border-collapse:collapse;
        background:var(--card);border-radius:8px;overflow:hidden}
  th,td{padding:10px 12px;text-align:left;border-bottom:1px solid #2a3340;
        vertical-align:top;font-size:13px}
  th{background:#222b37;color:var(--muted);font-weight:600;font-size:11px;
     text-transform:uppercase;letter-spacing:1px}
  tr.row{cursor:pointer}
  tr.row:hover{background:#222b37}
  tr.detail td{background:#13191f;padding:14px 18px;font-family:monospace;
               white-space:pre-wrap;word-break:break-all;font-size:12px;
               color:#cfd5dd}
  .sev{display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;
       font-weight:600;letter-spacing:0.5px}
  .sev.CRITICAL{background:var(--crit);color:#fff}
  .sev.HIGH{background:var(--high);color:#000}
  .sev.MEDIUM{background:var(--med);color:#000}
  .sev.LOW{background:var(--low);color:#000}
  .sev.INFO{background:var(--info);color:#000}
  .hash{font-family:monospace;color:var(--muted);font-size:11px}
  footer{padding:14px 28px;color:var(--muted);font-size:11px;text-align:center}
</style>
</head>
<body>
<header>
  <h1>PCAPTriage Report</h1>
  <div class="sub">
    {{ meta.path }} &middot; SHA-256
    <span class="hash">{{ meta.sha256 }}</span>
  </div>
</header>

<section class="cards">
  <div class="card"><h3>Packets</h3>
    <div class="v">{{ meta.packet_count }}</div></div>
  <div class="card"><h3>Duration (s)</h3>
    <div class="v">{{ "%.2f"|format(meta.duration_seconds) }}</div></div>
  <div class="card"><h3>Size (bytes)</h3>
    <div class="v">{{ meta.size_bytes }}</div></div>
  <div class="card"><h3>Findings</h3>
    <div class="v">{{ findings|length }}</div></div>
  <div class="card crit"><h3>Critical</h3>
    <div class="v">{{ severity_counts.CRITICAL }}</div></div>
  <div class="card high"><h3>High</h3>
    <div class="v">{{ severity_counts.HIGH }}</div></div>
  <div class="card med"><h3>Medium</h3>
    <div class="v">{{ severity_counts.MEDIUM }}</div></div>
  <div class="card low"><h3>Low</h3>
    <div class="v">{{ severity_counts.LOW }}</div></div>
</section>

<div class="toolbar">
  <input id="search" type="search" placeholder="Filter by type, IP, payload...">
  <select id="sev">
    <option value="">All severities</option>
    <option>CRITICAL</option><option>HIGH</option>
    <option>MEDIUM</option><option>LOW</option><option>INFO</option>
  </select>
</div>

<table id="tbl">
  <thead>
    <tr>
      <th>#</th><th>Severity</th><th>Type</th><th>Packet</th>
      <th>Source</th><th>Dest</th><th>SHA-256</th>
    </tr>
  </thead>
  <tbody></tbody>
</table>

<footer>Generated by PCAPTriage 0.1.0 — MBC Telkom University Lab</footer>

<script>
const FINDINGS = {{ findings_json|safe }};
const tbody = document.querySelector('#tbl tbody');
const search = document.getElementById('search');
const sevSel = document.getElementById('sev');

function render() {
  const q = search.value.toLowerCase();
  const s = sevSel.value;
  tbody.innerHTML = '';
  FINDINGS.forEach((f, i) => {
    if (s && f.severity !== s) return;
    if (q) {
      const hay = JSON.stringify(f).toLowerCase();
      if (!hay.includes(q)) return;
    }
    const tr = document.createElement('tr');
    tr.className = 'row';
    tr.innerHTML = `
      <td>${i}</td>
      <td><span class="sev ${f.severity}">${f.severity}</span></td>
      <td>${f.type}</td>
      <td>${f.packet_offset}</td>
      <td>${f.source_ip || '-'}</td>
      <td>${f.dest_ip || '-'}</td>
      <td class="hash">${(f.payload_hash || '').slice(0,16)}...</td>`;
    const detail = document.createElement('tr');
    detail.className = 'detail';
    detail.style.display = 'none';
    const td = document.createElement('td');
    td.colSpan = 7;
    td.textContent = JSON.stringify(f.details, null, 2);
    detail.appendChild(td);
    tr.addEventListener('click', () => {
      detail.style.display = detail.style.display === 'none' ? '' : 'none';
    });
    tbody.appendChild(tr);
    tbody.appendChild(detail);
  });
}
search.addEventListener('input', render);
sevSel.addEventListener('change', render);
render();
</script>
</body>
</html>
